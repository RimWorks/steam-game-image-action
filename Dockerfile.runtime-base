# Public, game-free base for the runnable image. The action `crane append`s the
# Steam game on top at /game. This layer provides xvfb + the X11/GL/audio native
# libs a Unity game (e.g. RimWorld's RimWorldLinux) needs to start headless.
#
# Contains NO game files and is safe to publish publicly.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        xvfb \
        xdotool \
        libgl1 \
        libglu1-mesa \
        libx11-6 \
        libxcursor1 \
        libxrandr2 \
        libxinerama1 \
        libxi6 \
        libxext6 \
        libxrender1 \
        libsdl2-2.0-0 \
        libnss3 \
        libasound2t64 \
        libpulse0 \
        libgtk-3-0 \
        locales \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8

# supplies a display and the native deps. a game with no headless mode still needs
# your own test-runner mod.
COPY scripts/headless-common.sh /usr/local/lib/headless-common.sh
COPY scripts/run-headless.sh /usr/local/bin/run-headless
RUN chmod +x /usr/local/bin/run-headless

# no USER: run-headless needs root to chown the mount parents, then drops to uid 1000.
# ubuntu:24.04 ships a stock user at uid 1000, so reclaim it first.
RUN userdel --remove ubuntu 2>/dev/null; useradd --create-home --uid 1000 app
ENV HOME=/home/app

WORKDIR /game
